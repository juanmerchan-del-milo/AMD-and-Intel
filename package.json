{
  "name":"amd-intel-cpu-lab",
  "version":"1.22.0",
  "description":"Laboratorio educativo de procesadores AMD e Intel para Windows, Linux, macOS, Android, iPhone/iPad y web.",
  "desktopName":"amd-intel-cpu-lab.desktop",
  "main":"desktop/main.cjs",
  "author":"Juan Pablo Merchan Sigua",
  "license":"MIT",
  "private":true,
  "scripts":{
    "start":"electron .",
    "check":"node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/renderer.js",
    "dist:linux":"electron-builder --linux AppImage tar.gz --x64 --publish never",
    "dist:win":"electron-builder --win nsis portable --x64 --publish never",
    "dist:mac":"electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "devDependencies":{"@electron/packager":"20.3.0","electron":"44.4.2","electron-builder":"26.15.3"},
  "build":{
    "appId":"com.juanpablo.amdintel.desktop",
    "productName":"AMD Intel CPU Lab",
    "asar":true,
    "compression":"maximum",
    "directories":{"output":"release"},
    "files":["index.html","v18-fixes.js","pwa.js","app-hero.png","desktop/**/*","package.json"],
    "linux":{"target":["AppImage","tar.gz"],"category":"Education","syncDesktopName":true,"icon":"build/icon.png","artifactName":"AMD-Intel-CPU-Lab-${version}-Linux-${arch}.${ext}"},
    "win":{"target":["nsis","portable"],"icon":"build/icon.ico","artifactName":"AMD-Intel-CPU-Lab-${version}-Windows-${arch}.${ext}"},
    "mac":{"target":["dmg","zip"],"category":"public.app-category.education","icon":"build/icon.icns","identity":null,"hardenedRuntime":false,"artifactName":"AMD-Intel-CPU-Lab-${version}-macOS-${arch}.${ext}"},
    "dmg":{"title":"AMD Intel CPU Lab ${version}"},
    "nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"createStartMenuShortcut":true,"shortcutName":"AMD Intel CPU Lab"}
  }
}